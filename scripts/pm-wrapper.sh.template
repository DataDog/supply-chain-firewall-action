#!/bin/bash
_real_bin=""
_remaining_path="${PATH}:"
while [ -n "$_remaining_path" ]; do
  _path_entry="${_remaining_path%%:*}"
  _remaining_path="${_remaining_path#*:}"
  _candidate="${_path_entry:-.}/SCFW_PM_NAME"
  # Compare file identity so symlinked paths (such as macOS /var) cannot recurse.
  if [ -f "$_candidate" ] && [ -x "$_candidate" ] &&
     ! [ "$_candidate" -ef "${BASH_SOURCE[0]}" ]; then
    _real_bin="$_candidate"
    break
  fi
done
if [ -z "$_real_bin" ]; then
  echo "scfw: could not find 'SCFW_PM_NAME' executable" >&2
  exit 1
fi
SCFW_PROXY_ENVexec scfw run --executable "$_real_bin" SCFW_EXTRA_FLAGS SCFW_PM_NAME "$@"
